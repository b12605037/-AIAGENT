# Copy this file to `.env.local` for `vercel dev`, or configure the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# Required for /api/chat (Gemini)
GEMINI_API_KEY=

# Optional — required only if /api/save should write to Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use \n for newlines inside the key when on one line, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
